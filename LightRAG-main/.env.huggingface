# ===== Server =====
HOST=0.0.0.0
PORT=9621
CORS_ORIGINS=*
SUMMARY_LANGUAGE=Vietnamese

# ===== LLM: Hugging Face Inference Providers via OpenAI-compatible chat =====
# Set HF_TOKEN in Hugging Face Space Secrets with "Make calls to Inference Providers".
LLM_BINDING=openai
LLM_MODEL=openai/gpt-oss-20b:novita
LLM_FALLBACK_MODELS=openai/gpt-oss-20b:together,openai/gpt-oss-120b:fireworks-ai,openai/gpt-oss-120b:novita
LLM_BINDING_API_KEY=${HF_TOKEN}
LLM_BINDING_HOST=https://router.huggingface.co/v1

# ===== Embedding: Hugging Face Inference API =====
EMBEDDING_BINDING=hf_inference
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_TOKEN_LIMIT=512
EMBEDDING_BINDING_HOST=https://router.huggingface.co/hf-inference/models
EMBEDDING_BINDING_API_KEY=${HF_TOKEN}
EMBEDDING_SEND_DIM=false

# ===== Storage: Lightweight (phù hợp HuggingFace free tier) =====
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# ===== Performance =====
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
RERANK_BINDING=null
ENABLE_LLM_CACHE_FOR_EXTRACT=true

# ===== Security =====
# Cấu hình API key trong HuggingFace Secrets, KHÔNG hardcode ở đây
# LIGHTRAG_API_KEY=${LIGHTRAG_API_KEY}
# WHITELIST_PATHS=/health,/api/*

# ===== Entity types phù hợp y tế =====
ENTITY_TYPES='["Thiết bị", "Khoa phòng", "Nhà sản xuất", "Quy trình", "Văn bản pháp quy", "Người", "Tổ chức", "Phương pháp", "Vật tư", "Sự kiện"]'
